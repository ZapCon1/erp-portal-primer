# Env contract for the default stack (docs/STACK.md). Placeholder values
# ONLY — copy to .env (gitignored) and fill. Add a startup check that
# fails loudly if a required var is missing (Day-1 checklist).
# Each var maps to a docs/STACK.md per-concern row.

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://CHANGEME_USER:CHANGEME@localhost:5432/erp
# Optional: separate owner-role URL for migrations (STACK.md § Integrity)
# DIRECT_DATABASE_URL=postgresql://CHANGEME_OWNER:CHANGEME@localhost:5432/erp

# --- App ---
APP_URL=http://localhost:3000

# --- Auth: TWO realms, TWO secrets — never share signing material
# across realms (STACK.md auth rows; CLAUDE.md § Security).
STAFF_AUTH_SECRET=CHANGEME
PORTAL_AUTH_SECRET=CHANGEME

# --- Email (Resend or Postmark via the same var names) ---
EMAIL_API_KEY=CHANGEME
EMAIL_FROM_ADDRESS=billing@example.com

# --- Payments (Stripe) — only if you bill online (secure_coding.md § 16)
STRIPE_SECRET_KEY=CHANGEME
STRIPE_WEBHOOK_SECRET=CHANGEME

# --- File storage (S3-compatible: S3/R2/B2/MinIO) — only if customers
# exchange documents (secure_coding.md § 17)
S3_BUCKET=CHANGEME
S3_REGION=auto
S3_ENDPOINT=            # empty for AWS; set for R2/B2/MinIO
S3_ACCESS_KEY_ID=CHANGEME
S3_SECRET_ACCESS_KEY=CHANGEME
