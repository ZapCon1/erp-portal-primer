# Env contract for the default stack (docs/STACK.md). Placeholder values
# ONLY — copy to .env (gitignored) and fill. Add a startup check that
# fails loudly if a required var is missing (Day-1 checklist).
# Each var maps to a docs/STACK.md per-concern row.

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://CHANGEME_USER:CHANGEME@localhost:5432/erp
# Optional: separate owner-role URL for migrations (STACK.md § Integrity)
# DIRECT_DATABASE_URL=postgresql://CHANGEME_OWNER:CHANGEME@localhost:5432/erp

# --- App ---
APP_URL=http://localhost:3000

# --- Auth: TWO realms, TWO secrets — never share signing material
# across realms (STACK.md auth rows; CLAUDE.md § Security).
STAFF_AUTH_SECRET=CHANGEME
PORTAL_AUTH_SECRET=CHANGEME

# SEC-2 — the dev-auth stub is FAIL-CLOSED: it runs only when NODE_ENV is
# 'development' AND this says yes. Unset, misspelled, or any other value and
# the app refuses to boot rather than serving a fake session. Never set it in
# a deployed environment; that is the whole control.
ALLOW_DEV_AUTH=yes

# --- Email (Resend or Postmark via the same var names) ---
EMAIL_API_KEY=CHANGEME
EMAIL_FROM_ADDRESS=billing@example.com

# --- Payments (Stripe) — only if you bill online (secure_coding.md § 16)
STRIPE_SECRET_KEY=CHANGEME
STRIPE_WEBHOOK_SECRET=CHANGEME

# --- File storage (S3-compatible: S3/R2/B2/MinIO) — only if customers
# exchange documents (secure_coding.md § 17)
S3_BUCKET=CHANGEME
S3_REGION=auto
S3_ENDPOINT=            # empty for AWS; set for R2/B2/MinIO
S3_ACCESS_KEY_ID=CHANGEME
S3_SECRET_ACCESS_KEY=CHANGEME

# ============================================================================
# OPTIONAL INTEGRATIONS — every one of these is an EGRESS PATH.
#
# Leave them commented until you actually enable the module. A fail-loud
# startup check should demand only what you use; twenty required vars nobody
# needs is how people learn to ignore it.
#
# CUI-1: each provider record carries mayReceiveControlledData, default
# false. Having a key here does NOT mean controlled files may be sent to it
# (docs/MODULES.md § Compliance posture).
# ============================================================================

# --- Error tracking + uptime (OPS-3) — the audit log says what happened,
# this says what failed to happen. graduation.sh REQUIRES this once you have
# something deployable. Scrub payloads at beforeSend if you hold CUI.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --- Email via SES instead of Resend/Postmark (docs/modules/transactional-email.md)
# Uses AWS credentials rather than EMAIL_API_KEY above. In dev the mailer
# writes to the console — magic link included — so DNS never blocks you.
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Toolpath DFM (docs/modules/toolpath.md) — Bearer credential, NOT an
# X-API-Key header. CORS is per-key: never put this in a browser bundle.
# Everything the API returns is MILLIMETRES AND DEGREES.
# TOOLPATH_API_KEY=
# TOOLPATH_BASE_URL=https://api.toolpath.com

# --- Cloud file storage (docs/modules/file-storage.md) — Box · Dropbox ·
# SharePoint/OneDrive · Drive. Distinct from the S3 bucket above: that is
# YOUR object store, this is a service your staff already use. Their sharing
# settings become your access control.
# FILE_STORAGE_PROVIDER=          # box | dropbox | sharepoint | gdrive
# FILE_STORAGE_CLIENT_ID=
# FILE_STORAGE_CLIENT_SECRET=

# --- Google Workspace / Microsoft 365 (calendar, mail, contacts)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# --- Accounting sync (QuickBooks · Xero · Puzzle) — pairs with the
# Accounting module. Sent-invoice immutability still applies on both sides.
# ACCOUNTING_PROVIDER=            # quickbooks | xero | puzzle
# ACCOUNTING_CLIENT_ID=
# ACCOUNTING_CLIENT_SECRET=
