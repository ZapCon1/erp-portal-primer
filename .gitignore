# Secrets — never commit these. Verify this file exists BEFORE your first commit.
.env
.env.*
!.env.example
*.pem
*.p12
*.key
id_rsa*
credentials*.json

# Local databases (SQLite etc.)
*.db
*.sqlite
*.sqlite3

# Dependencies & build artifacts — uncomment / add what your stack produces
node_modules/
dist/
build/
.next/
coverage/
__pycache__/
*.pyc
.venv/
target/

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Review, audit and screenshot output — local only, by design.
#
# These say in writing where the product is weak (the competitor's angle,
# security gaps, features claimed but not built), or show it on screen. That
# candour is exactly the point and exactly what nobody wants published by
# accident. Act on them; let the *fixes* be what reaches the repo.
#
# Note this deliberately does NOT ignore images generally — BRAND.md may
# reference a logo that belongs in the repo. It ignores the places review and
# screenshot output lands.
reviews/
screenshots/
shots/
docs/reviews/
docs/audits/
*.review.md
*.audit.md
panel-review-*.md

# Scratch working files from a review or fix session
*.draft.md
*.bak
.*.bak
