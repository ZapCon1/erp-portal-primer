# Secrets — never commit these. Verify this file exists BEFORE your first commit.
.env
.env.*
!.env.example
*.pem
*.p12
*.key
id_rsa*
credentials*.json

# Local databases (SQLite etc.)
*.db
*.sqlite
*.sqlite3

# Dependencies & build artifacts — uncomment / add what your stack produces
node_modules/
dist/
build/
.next/
coverage/
__pycache__/
*.pyc
.venv/
target/

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Panel review reports — local only, by design.
# /panel-review writes here. These say in writing where the product is weak
# (the competitor's angle, security gaps, features claimed but not built) —
# that candor is the point, and it is not for publishing by accident.
# Act on them; let the fixes be what reaches the repo. Delete this line only
# as a deliberate choice, if your team keeps reviews as shared decision records.
reviews/
